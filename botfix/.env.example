# Copy this file to .env for local testing (Heroku: set these as Config Vars instead).

# ── Required ─────────────────────────────────────────────
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_PRIMARY_SESSION=your_telethon_session_string_here

# ── Music (voice chat streaming) ─────────────────────────
TELEGRAM_PYRO_SESSION=your_pyrogram_session_string_here

# ── YouTube Cookies (RECOMMENDED for best music quality) ─────────────────────
# Without cookies: bot uses 40-jugad bypass (works for most public songs)
# With cookies:    age-restricted, geo-locked, and bot-checked videos also work
#
# How to get cookies:
#   1. Log into YouTube in Chrome or Firefox
#   2. Install "Get cookies.txt LOCALLY" browser extension
#   3. Go to youtube.com → click the extension → Export → "For this domain"
#   4. Copy the ENTIRE file content (starts with "# Netscape HTTP Cookie File")
#   5. Paste it as the value of YTDLP_COOKIES below (or Heroku Config Var)
#
# TIP: Refresh cookies every 30-60 days to keep them valid.
YTDLP_COOKIES=

# ── Optional ──────────────────────────────────────────────
TELEGRAM_LOG_CHANNEL_ID=-100xxxxxxxxx
TELEGRAM_OWNER_ID=your_numeric_user_id
TELEGRAM_OWNER_USERNAME=your_username_without_at
TELEGRAM_HELP_LINK=https://t.me/your_support_link
GEMINI_API_KEY=your_gemini_api_key
JAMENDO_CLIENT_ID=
PIXABAY_API_KEY=

# ── GitHub backup (so bot data survives Heroku restarts) ─
GITHUB_TOKEN=your_github_pat_with_repo_scope
GITHUB_REPO=yourname/your-data-repo
GITHUB_BRANCH=main
GITHUB_DATA_PATH=data/config.json
